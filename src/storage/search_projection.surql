SELECT
    'source_data' AS content_kind,
    string::slice(data.text, 0, $max_text_chars) AS text,
    string::len(data.text) > $max_text_chars AS text_truncated,
    data.source_id AS source_id,
    document.source.data.name AS source_name,
    data.document_url AS document_url,
    data.title AS title,
    data.section_id AS section_id,
    data.heading_path AS heading_path,
    data.anchor AS anchor,
    data.source_url AS url,
    data.crawl_id AS crawl_id,
    data.crawled_at AS crawled_at,
    data.id AS chunk_id,
    data.content_sha256 AS content_sha256,
    sequence,
    data.block_start AS block_start,
    data.block_end AS block_end,
    search::score(0) AS score,
    'full_text' AS match_kind
