SELECT
    'source_data' AS content_kind,
    string::slice(chunk.data.text, 0, $max_text_chars) AS text,
    string::len(chunk.data.text) > $max_text_chars AS text_truncated,
    chunk.data.source_id AS source_id,
    chunk.document.source.data.name AS source_name,
    chunk.data.document_url AS document_url,
    chunk.data.title AS title,
    chunk.data.section_id AS section_id,
    chunk.data.heading_path AS heading_path,
    chunk.data.anchor AS anchor,
    chunk.data.source_url AS url,
    chunk.data.crawl_id AS crawl_id,
    chunk.data.crawled_at AS crawled_at,
    chunk.data.id AS chunk_id,
    chunk.data.content_sha256 AS content_sha256,
    chunk.sequence AS sequence,
    chunk.data.block_start AS block_start,
    chunk.data.block_end AS block_end,
    'vector' AS match_kind,
    $space AS embedding_space
